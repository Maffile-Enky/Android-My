        <item name="colorPrimary">@color/orange_primary_dark_variant</item>
        <item name="colorPrimaryDark">@color/orange_primary_dark_dark_variant</item>
        <item name="colorAccent">@color/orange_accent_dark_variant</item>
    </style>

    <!-- 夜间：优雅紫 -->
    <style name="Theme.Jjjjjppppp.Purple" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_primary_dark_variant</item>
