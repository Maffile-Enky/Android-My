<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- ===== 登录区域 (未登录时显示) ===== -->
        <LinearLayout
            android:id="@+id/layoutLoginSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3" />

            <ImageView
                android:id="@+id/ivLoginAvatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@mipmap/ic_launcher"
                android:background="@drawable/circle_background"
                android:padding="6dp" />

            <TextView
                android:id="@+id/tvLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户登录"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvLoginSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="欢迎回来，请登录您的账号"
                android:textSize="14sp"
                android:textColor="@color/hint_text"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardLoginForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <EditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="用户名"
                        android:inputType="text"
                        android:textSize="16sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/display_background" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="密码"
                        android:inputType="textPassword"
                        android:textSize="16sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/display_background"
                        android:layout_marginTop="12dp" />

                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="登 录"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/primary"
                        app:cornerRadius="8dp"
                        android:layout_marginTop="20dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="注册新账号"
                android:textSize="16sp"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/primary"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3" />

        </LinearLayout>

        <!-- ===== 个人资料区域 (登录后显示) ===== -->
        <LinearLayout
            android:id="@+id/layoutProfileSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWelcomeHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已登录，欢迎回来"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/ivProfileAvatar"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@mipmap/ic_launcher"
                        android:background="@drawable/circle_background"
                        android:padding="6dp" />

                    <TextView
                        android:id="@+id/tvChangeAvatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击更换头像"
                        android:textSize="12sp"
                        android:textColor="@color/hint_text"
                        android:layout_marginTop="4dp" />

                    <EditText
                        android:id="@+id/etNickname"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="昵称"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:background="@drawable/display_background"
                        android:layout_marginTop="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/display_background">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="性别"
                            android:textSize="14sp"
                            android:textColor="@color/hint_text" />

                        <RadioGroup
                            android:id="@+id/rgGender"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginStart="16dp">

                            <RadioButton
                                android:id="@+id/rbMale"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="男" />

                            <RadioButton
                                android:id="@+id/rbFemale"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="女"
                                android:layout_marginStart="24dp" />

                        </RadioGroup>

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etBirthday"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="生日 (例如 1990-01-01)"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:background="@drawable/display_background"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="手机号"
                        android:inputType="phone"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:background="@drawable/display_background"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="邮箱"
                        android:inputType="textEmailAddress"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:background="@drawable/display_background"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="地址"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:background="@drawable/display_background"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:id="@+id/etBio"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:hint="个性签名"
                        android:textSize="14sp"
                        android:gravity="top"
                        android:padding="12dp"
                        android:background="@drawable/display_background"
                        android:layout_marginTop="12dp" />

                    <Button
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="保存信息"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/primary"
                        app:cornerRadius="8dp"
                        android:layout_marginTop="20dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="退出登录"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/negative_count"
                app:cornerRadius="8dp"
                android:layout_marginTop="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
